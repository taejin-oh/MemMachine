# Site-specific values for tools/ces2027_demo. Copy this file to `.env` in the
# same directory and edit it. docker-compose.yml and the scripts in ../scripts
# read it; nothing else changes between the Mac, the company servers and the
# booth.

# --- Where the other servers are -------------------------------------------
# Containers reach the other servers by the fixed names db, llm and embed.
# Booth:  the IP address of each server (for example 10.77.0.12).
# Mac:    host-gateway, which Docker resolves to the Mac itself; the mock and
#         the databases publish their ports there.
DB_HOST=host-gateway
LLM_HOST=host-gateway
EMBED_HOST=host-gateway
# Address of the app server for scripts that run outside Docker.
# Booth: the app server IP. Mac: 127.0.0.1.
APP_HOST=127.0.0.1

# Host ports published by the app server. Keep 3000 and 8080 in the booth; on
# the Mac they are often taken, so free ones are used here.
OPENWEBUI_PORT=3300
MEMMACHINE_PORT=8380

# --- Models ----------------------------------------------------------------
# Served name of the chat model a new chat opens with (vLLM --served-model-name). Mac: a mock name
# starting with "mock-"; demo_check.py turns the memory checks into warnings when every embedding model
# is named like that.
LLM_MODEL_NAME=mock-llm-a
# Every chat model the demo offers, separated by ','; empty means LLM_MODEL_NAME alone. Each one gets the
# four entries (memory / no memory, instant / step by step), so staff can switch chat model in the picker
# while a new chat still opens with LLM_MODEL_NAME. Also the Pipe's list filter: a shared gateway serves
# dozens of ids (embeddings and rerankers included) and would otherwise put four entries per id in the
# dropdown. List here only ids that are actually served; the setup script makes the entries from this key.
LLM_MODEL_ALLOW=
# OpenAI-compatible chat servers as seen from the containers, separated by ';'.
# The Pipe calls them for both cards (setup_openwebui.py writes the value into
# its valve) and demo_check.py probes them. One entry per vLLM process; both
# LLM_MODEL_ALLOW models must be answered by one of them.
LLM_BASE_URLS=http://llm:8000/v1
# A gateway that routes by host name (LiteLLM at a company) must resolve inside the
# container, where the host's /etc/hosts is not visible; docker-compose.yml adds this
# pair to the Open WebUI container. Leave both unset when LLM_BASE_URLS uses an IP or
# the compose name llm.
#GATEWAY_HOST=gateway.example.com
#GATEWAY_IP=10.0.0.5
# Bearer token for those servers. vLLM ignores it; a gateway may require it, and some also answer 401 to
# the anonymous /v1/models probe that demo_check.py and demo_monitor.py make, so they send this too.
# setup_openwebui.py writes it into the Pipe valve LLM_API_KEY. Keep it in .env (gitignored), not in the
# scripts or the Pipe source.
LLM_API_KEY=
# true: both cards ask the chat server to answer without reasoning first (chat_template_kwargs
# {enable_thinking: false}). Needed for a Qwen3-family chat model that is served without the operator's
# --default-chat-template-kwargs: it otherwise spends the whole MAX_TOKENS budget on thinking and the card
# stays empty (measured on a company gateway: 1979 reasoning tokens, no answer). A server whose template
# ignores the key is unaffected. setup_openwebui.py writes it into the Pipe valve DISABLE_THINKING.
LLM_DISABLE_THINKING=

# Time zone of the device the demo is recorded on. The Pipe shows memory dates
# in it, matching the chat timestamps the browser shows. The scripts' dates
# carry +09:00, so with Seoul here both show the dates as written. The booth
# plays the recording and needs no other value.
TZ=Asia/Seoul

# --- vLLM servers (booth profiles llm and embed) -----------------------------
# Not used on the Mac. Pin the image tag; change it only together with a
# company verification. When an operator already serves both models outside
# compose (company check), the llm and embed profiles are not started and the
# values below only have to parse; the operator's servers must then listen on
# 8000 and 8001 and serve the ids LLM_MODEL_NAME and "embed" (runbook 2.4).
VLLM_IMAGE=vllm/vllm-openai:v0.26.0
# Directories with the model weights in Hugging Face layout, mounted read-only.
LLM_MODEL_PATH=/models/llm
EMBED_MODEL_PATH=/models/embed
# GPU index each server uses on its host. 0 when the host has one GPU; in a
# company test with both vLLMs on one host give them different indexes.
LLM_GPU=0
EMBED_GPU=0
# Fraction of the GPU memory vLLM may take. Lower it when the GPU is shared.
LLM_GPU_MEMORY=0.90
EMBED_GPU_MEMORY=0.20
# Longest prompt plus answer in tokens; the demo prompts are short.
LLM_MAX_MODEL_LEN=8192
# Extra vLLM engine arguments if a model needs them. Empty is fine. Examples:
#   LLM_EXTRA_ARGS=--default-chat-template-kwargs '{"enable_thinking": false}'
#     (Qwen3 family: otherwise the model thinks first and the left card stays
#     empty until the answer starts)
#   EMBED_EXTRA_ARGS=--hf-overrides '{"is_matryoshka": true}'
#     (lets vLLM accept the `dimensions` parameter for a model whose config
#     does not declare it, such as Qwen3-Embedding; see runbook section 6.2)
#   EMBED_EXTRA_ARGS=--convert embed
#     (a model vLLM does not recognise as an embedding model)
LLM_EXTRA_ARGS=
EMBED_EXTRA_ARGS=

# --- Open WebUI ------------------------------------------------------------
# Staff account, used by the scripts. The first sign-up becomes the admin.
ADMIN_NAME=Demo Staff
ADMIN_EMAIL=staff@demo.local
ADMIN_PASSWORD=change-me
# Booth account: the regular user the booth screen signs in as. The setup
# script creates it; the permissions in docker-compose.yml apply to it.
BOOTH_NAME=Visitor
BOOTH_EMAIL=visitor@demo.local
BOOTH_PASSWORD=change-me
# Any long random string. Logins survive a restart only if it stays fixed.
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
# Name of the memory side as the screen shows it: the left model is
# "<BRAND_NAME> + <model>", the right card's note says it answers without it,
# and the Pipe is listed under it in Admin Panel > Functions. Ids, file names
# and the error prefix "MemMachine pipe:" that demo_check.py looks for do not
# change. The setup script writes it into the Pipe valve BRAND_NAME.
BRAND_NAME=MemMachine
# Avatars shown next to the memory models and the no-memory models: a PNG in
# ../assets (192x192, transparency allowed; Open WebUI rejects SVG) or an
# absolute path, for a picture kept outside the repository. The setup script
# embeds them into the four model entries. Files in ../assets:
#   memmachine.png      MemMachine mark on blue      no_memory.png        same mark greyed and struck
#   skhynix.png         SK hynix logo on white       no_memory_plain.png  struck-through list, no mark
# Booth: AVATAR_MEMORY=skhynix.png and AVATAR_NO_MEMORY=no_memory_plain.png.
AVATAR_MEMORY=memmachine.png
AVATAR_NO_MEMORY=no_memory.png
# Whether a new chat opens as a temporary chat. false: a question is saved
# like any chat, so the recording shows it in the sidebar, and staff delete it
# afterwards (the recorded demo; see the cold demo document, section 6). true:
# a visitor's questions are never saved and the sidebar keeps only the loaded
# past chats (a live booth). The setup script writes it into both accounts;
# run it again after a change.
TEMPORARY_CHAT=false
# Which pair a new chat opens with. Empty: the instant pair (answers at once).
# true: the "(step by step)" pair, which shows the memory search, the prompt
# and the LLM call before the answer. Only these two values: docker-compose.yml
# tests whether the value is empty, so "false" would also mean true, and the
# scripts stop on it. After a change run `docker compose --profile app up -d
# openwebui` (the container is recreated; the volume and logins stay).
STEPS_BY_DEFAULT=
# Both models are told "Today is <weekday>, <DEMO_DATE>." (in the script's
# language) so that "this Saturday" means the same day regardless of the
# server clock and needs no calendar arithmetic. Leave empty to omit the line.
# The system prompt shared by both models is not here: it is in the script
# file (scenario/script_en.json, script_ko.json) next to the language of the
# screen texts, and load_scenario.py writes both into the Pipe valves, so one
# load switches the whole screen to that language. A BASE_SYSTEM_PROMPT line
# left here from an older .env is ignored.
DEMO_DATE=2027-01-06

# --- Models that answer without the Pipe (no memory card) ------------------
# Off by default: the comparison demo is two Pipe models, and Open WebUI then holds no model
# connection of its own (design section 5.3). true makes Open WebUI open its own connection to
# DIRECT_LLM_BASE_URLS, so a served model can be selected plain — no memory list, no demo system
# prompt, no Valve. Useful for testing one model by itself. Only "true" or empty, as with
# STEPS_BY_DEFAULT; after a change run `docker compose --profile app up -d openwebui` and
# setup_openwebui.py again. Keep it off for the recording: the booth account would see these
# models next to the four demo entries.
DIRECT_LLM_ENABLED=
# One URL per server, separated by ';', as the container reaches them (the compose network's
# 'llm', or a gateway's real name).
DIRECT_LLM_BASE_URLS=
# REQUIRED, and it must list only the ids each server answers. A connection without model_ids lists
# every id that server serves: a shared gateway would then offer its embedders and rerankers too.
# An id under the wrong server appears in the list and fails when selected ("model does not exist").
# The key is the connection's index in DIRECT_LLM_BASE_URLS.
DIRECT_LLM_CONFIGS=
# Optional: one key per connection, ';'-separated. Unset, LLM_API_KEY is sent to the first
# connection and the rest get none, which a plain vLLM accepts. Order matters.
#DIRECT_LLM_KEYS=sk-…;dummy

# --- Databases -------------------------------------------------------------
# PostgreSQL password, used by the db server and by MemMachine. Port 5432 is
# open on the booth network, so choose one for the booth instead of this
# example (the runbook generates it with openssl rand -hex). It can only be set
# before the postgres_data volume exists; afterwards the volume keeps the old one.
POSTGRES_PASSWORD=memmachine
