# Site-specific values for tools/ces2027_demo. Copy this file to `.env` in the
# same directory and edit it. docker-compose.yml and the scripts in ../scripts
# read it; nothing else changes between the Mac, the company servers and the
# booth.

# --- Where the other servers are -------------------------------------------
# Containers reach the other servers by the fixed names db, llm and embed.
# Booth:  the IP address of each server (for example 10.77.0.12).
# Mac:    host-gateway, which Docker resolves to the Mac itself; the mock and
#         the databases publish their ports there.
DB_HOST=host-gateway
LLM_HOST=host-gateway
EMBED_HOST=host-gateway
# Address of the app server for scripts that run outside Docker.
# Booth: the app server IP. Mac: 127.0.0.1.
APP_HOST=127.0.0.1

# Host ports published by the app server. Keep 3000 and 8080 in the booth; on
# the Mac they are often taken, so free ones are used here.
OPENWEBUI_PORT=3300
MEMMACHINE_PORT=8380

# --- Models ----------------------------------------------------------------
# Served name of the chat model (vLLM --served-model-name). Mac: a mock name
# starting with "mock-"; demo_check.py turns the memory checks into warnings
# when every embedding model is named like that.
LLM_MODEL_NAME=mock-llm-a
# OpenAI-compatible chat servers as seen from the containers, separated by ';'.
# Used by both cards: Open WebUI calls it directly for the no-memory model and
# the Pipe calls it for the memory model. One entry per vLLM process.
LLM_BASE_URLS=http://llm:8000/v1

# Time zone of the display device. Memory dates in the left card are shown in
# it, matching the chat timestamps the browser shows. The booth is in Las
# Vegas; keeping this on the Mac makes the sample script's dates show as written.
TZ=America/Los_Angeles

# --- vLLM servers (booth profiles llm and embed) -----------------------------
# Not used on the Mac. Pin the image tag; change it only together with a
# company verification. When an operator already serves both models outside
# compose (company check), the llm and embed profiles are not started and the
# values below only have to parse; the operator's servers must then listen on
# 8000 and 8001 and serve the ids LLM_MODEL_NAME and "embed" (runbook 2.4).
VLLM_IMAGE=vllm/vllm-openai:v0.26.0
# Directories with the model weights in Hugging Face layout, mounted read-only.
LLM_MODEL_PATH=/models/llm
EMBED_MODEL_PATH=/models/embed
# GPU index each server uses on its host. 0 when the host has one GPU; in a
# company test with both vLLMs on one host give them different indexes.
LLM_GPU=0
EMBED_GPU=0
# Fraction of the GPU memory vLLM may take. Lower it when the GPU is shared.
LLM_GPU_MEMORY=0.90
EMBED_GPU_MEMORY=0.20
# Longest prompt plus answer in tokens; the demo prompts are short.
LLM_MAX_MODEL_LEN=8192
# Extra vLLM engine arguments if a model needs them. Empty is fine. Examples:
#   LLM_EXTRA_ARGS=--default-chat-template-kwargs '{"enable_thinking": false}'
#     (Qwen3 family: otherwise the model thinks first and the left card stays
#     empty until the answer starts)
#   EMBED_EXTRA_ARGS=--hf-overrides '{"is_matryoshka": true}'
#     (lets vLLM accept the `dimensions` parameter for a model whose config
#     does not declare it, such as Qwen3-Embedding; see runbook section 6.2)
#   EMBED_EXTRA_ARGS=--convert embed
#     (a model vLLM does not recognise as an embedding model)
LLM_EXTRA_ARGS=
EMBED_EXTRA_ARGS=

# --- Open WebUI ------------------------------------------------------------
# Staff account, used by the scripts. The first sign-up becomes the admin.
ADMIN_NAME=Demo Staff
ADMIN_EMAIL=staff@demo.local
ADMIN_PASSWORD=change-me
# Booth account: the regular user the booth screen signs in as. The setup
# script creates it; the permissions in docker-compose.yml apply to it.
BOOTH_NAME=Visitor
BOOTH_EMAIL=visitor@demo.local
BOOTH_PASSWORD=change-me
# Any long random string. Logins survive a restart only if it stays fixed.
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
# Both models are told "Today is <DEMO_DATE>." so that "this Saturday" means
# the same day regardless of the server clock. Leave empty to omit the line.
DEMO_DATE=2027-01-06
# System prompt shared by both models. The left model adds its memory block.
BASE_SYSTEM_PROMPT=You are a helpful assistant. Answer briefly and concretely.

# --- Databases -------------------------------------------------------------
POSTGRES_PASSWORD=memmachine
