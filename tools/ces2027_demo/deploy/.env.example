# Site-specific values for tools/ces2027_demo. Copy this file to `.env` in the
# same directory and edit it. docker-compose.yml and the scripts in ../scripts
# read it; nothing else changes between the Mac, the company servers and the
# booth.

# --- Where the other servers are -------------------------------------------
# Containers reach the other servers by the fixed names db, llm and embed.
# Booth:  the IP address of each server (for example 10.77.0.12).
# Mac:    host-gateway, which Docker resolves to the Mac itself; the mock and
#         the databases publish their ports there.
DB_HOST=host-gateway
LLM_HOST=host-gateway
EMBED_HOST=host-gateway
# Address of the app server for scripts that run outside Docker.
# Booth: the app server IP. Mac: 127.0.0.1.
APP_HOST=127.0.0.1

# Host ports published by the app server. Keep 3000 and 8080 in the booth; on
# the Mac they are often taken, so free ones are used here.
OPENWEBUI_PORT=3300
MEMMACHINE_PORT=8380

# --- Models ----------------------------------------------------------------
# Served name of the chat model (vLLM --served-model-name). Mac: a mock name.
LLM_MODEL_NAME=mock-llm-a
# OpenAI-compatible chat servers as seen from the containers, separated by ';'.
# Used by both cards: Open WebUI calls it directly for the no-memory model and
# the Pipe calls it for the memory model. One entry per vLLM process.
LLM_BASE_URLS=http://llm:8000/v1

# Time zone of the display device. Memory dates in the left card are shown in
# it, matching the chat timestamps the browser shows.
TZ=Asia/Seoul

# --- Open WebUI ------------------------------------------------------------
# Staff account. The first sign-up becomes the admin.
ADMIN_NAME=Demo Staff
ADMIN_EMAIL=staff@demo.local
ADMIN_PASSWORD=change-me
# Any long random string. Logins survive a restart only if it stays fixed.
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
# Both models are told "Today is <DEMO_DATE>." so that "this Saturday" means
# the same day regardless of the server clock. Leave empty to omit the line.
DEMO_DATE=2027-01-06
# System prompt shared by both models. The left model adds its memory block.
BASE_SYSTEM_PROMPT=You are a helpful assistant. Answer briefly and concretely.

# --- Databases -------------------------------------------------------------
POSTGRES_PASSWORD=memmachine
