@@ -0,0 +1,345 @@
+//! 단계별 계측 (stage timing)
+//!
+//! 검색 9개 지점(S0~S8)과 저장 9개 지점(W0~W8)의 소요 시간을 누적한다.
+//! 계측 지점의 근거는 `docs/msr/qdrant_bottleneck/stage_isolation_2026-09-18.md` 에 있다.
+//!
+//! # 설계
+//!
+//! 요청마다 단계별 시간을 따로 남기지 않고 **단계별 총합과 호출 횟수만 누적한다.**
+//! 병목 지점을 가리는 데에는 단계별 총합이면 충분하고, 요청별 지연 분포는
+//! Qdrant 기본 기능으로 이미 얻기 때문이다. 요청 단위로 묶지 않으므로 호출 스택에
+//! 문맥을 실어 나를 필요가 없고, 그만큼 소스 변경이 작아진다.
+//!
+//! 반복이 많은 구간(S4, S5, W8)은 호출마다 원자적 연산을 하면 계측 비용이
+//! 측정 대상을 넘어선다. 그런 구간은 [`StageAccum`] 으로 지역 변수에 더한 뒤
+//! 루프를 빠져나올 때 한 번만 반영한다.
+//!
+//! # 끄고 켜기
+//!
+//! `stage-timing` 기능을 끄면 모든 호출이 빈 코드로 컴파일된다.
+//! 계측 유무 빌드를 같은 부하로 비교해 왜곡을 확인할 때 쓴다.
+//!
+//! ```text
+//! cargo build --release                          # 계측 없음
+//! cargo build --release --features stage-timing  # 계측 있음
+//! ```
+
+#[cfg(feature = "stage-timing")]
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// 계측 지점. 값은 [`STAGE_NAMES`] 의 첨자와 같아야 한다.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+#[repr(usize)]
+pub enum Stage {
+    // --- 검색 ---
+    /// S0 세그먼트 읽기 잠금 대기
+    SegmentReadLock = 0,
+    /// S1 카디널리티 추정
+    CardinalityEstimate = 1,
+    /// S2 필터 평가
+    FilterEval = 2,
+    /// S3 스코어러 준비
+    ScorerSetup = 3,
+    /// S4 거리 계산 (루프 내부, 누적)
+    DistanceCalc = 4,
+    /// S5 결과 수집과 정렬 (루프 내부, 누적)
+    ResultCollect = 5,
+    /// S6 후처리
+    PostProcess = 6,
+    /// S7 세그먼트 결과 병합
+    SegmentMerge = 7,
+    /// S8 재검색
+    Rerun = 8,
+
+    // --- 저장 ---
+    /// W0 대기열 자리 확보
+    QueueReserve = 9,
+    /// W1 WAL 기록
+    WalWrite = 10,
+    /// W2 WAL 확정 (기존 지표의 사각지대)
+    WalFlush = 11,
+    /// W3 전역 쓰기 락 대기 (기존 지표의 사각지대)
+    GlobalWriteLock = 12,
+    /// W4 세그먼트 홀더 락
+    SegmentHolderLock = 13,
+    /// W5 대상 세그먼트 선택
+    SegmentSelect = 14,
+    /// W6 벡터 저장
+    VectorWrite = 15,
+    /// W7 payload 저장
+    PayloadWrite = 16,
+    /// W8 색인 갱신 (필드별 누적)
+    IndexUpdate = 17,
+}
+
+/// 계측 지점 개수. 검색 9 + 저장 9.
+pub const STAGE_COUNT: usize = 18;
+
+/// 지표 이름. `Stage` 의 값 순서와 반드시 일치해야 한다.
+pub const STAGE_NAMES: [&str; STAGE_COUNT] = [
+    "s0_segment_read_lock",
+    "s1_cardinality_estimate",
+    "s2_filter_eval",
+    "s3_scorer_setup",
+    "s4_distance_calc",
+    "s5_result_collect",
+    "s6_post_process",
+    "s7_segment_merge",
+    "s8_rerun",
+    "w0_queue_reserve",
+    "w1_wal_write",
+    "w2_wal_flush",
+    "w3_global_write_lock",
+    "w4_segment_holder_lock",
+    "w5_segment_select",
+    "w6_vector_write",
+    "w7_payload_write",
+    "w8_index_update",
+];
+
+/// 단계 하나의 누적값.
+///
+/// 캐시 라인 하나를 통째로 차지하게 해 서로 다른 단계가 같은 라인을 두고
+/// 다투지 않도록 한다. S4 와 S5 는 호출 빈도가 높아 이 구분이 실제로 효과가 있다.
+#[cfg(feature = "stage-timing")]
+#[repr(align(64))]
+pub struct StageStat {
+    nanos: AtomicU64,
+    count: AtomicU64,
+}
+
+#[cfg(feature = "stage-timing")]
+impl StageStat {
+    const fn new() -> Self {
+        Self {
+            nanos: AtomicU64::new(0),
+            count: AtomicU64::new(0),
+        }
+    }
+}
+
+// 배열을 상수 하나로 반복 초기화한다. 인라인 const 표현식을 쓰지 않으므로
+// 오래된 툴체인에서도 컴파일된다.
+#[cfg(feature = "stage-timing")]
+#[allow(clippy::declare_interior_mutable_const)]
+const EMPTY_STAT: StageStat = StageStat::new();
+
+#[cfg(feature = "stage-timing")]
+static STATS: [StageStat; STAGE_COUNT] = [EMPTY_STAT; STAGE_COUNT];
+
+/// 단계 하나에 소요 시간을 더한다.
+///
+/// 호출 한 번에 원자적 덧셈 두 번이 든다. 요청당 한 번 호출되는 구간에 쓴다.
+/// 루프 안에서는 [`StageAccum`] 을 쓴다.
+#[inline(always)]
+pub fn record(stage: Stage, nanos: u64) {
+    #[cfg(feature = "stage-timing")]
+    {
+        let stat = &STATS[stage as usize];
+        stat.nanos.fetch_add(nanos, Ordering::Relaxed);
+        stat.count.fetch_add(1, Ordering::Relaxed);
+    }
+    #[cfg(not(feature = "stage-timing"))]
+    {
+        let _ = (stage, nanos);
+    }
+}
+
+/// 범위를 벗어날 때 자동으로 시간을 기록하는 가드.
+///
+/// 측정하려는 호출 바로 앞에 두고, 그 범위가 끝나면 기록된다.
+///
+/// ```ignore
+/// let _t = StageGuard::new(Stage::CardinalityEstimate);
+/// let estimate = payload_index.estimate_cardinality(filter, ..);
+/// ```
+pub struct StageGuard {
+    #[cfg(feature = "stage-timing")]
+    stage: Stage,
+    #[cfg(feature = "stage-timing")]
+    start: std::time::Instant,
+}
+
+impl StageGuard {
+    #[inline(always)]
+    pub fn new(stage: Stage) -> Self {
+        #[cfg(feature = "stage-timing")]
+        {
+            Self {
+                stage,
+                start: std::time::Instant::now(),
+            }
+        }
+        #[cfg(not(feature = "stage-timing"))]
+        {
+            let _ = stage;
+            Self {}
+        }
+    }
+}
+
+impl Drop for StageGuard {
+    #[inline(always)]
+    fn drop(&mut self) {
+        #[cfg(feature = "stage-timing")]
+        {
+            record(self.stage, self.start.elapsed().as_nanos() as u64);
+        }
+    }
+}
+
+/// 루프 안에서 쓰는 누적기.
+///
+/// 호출마다 지역 변수에 더하고, 범위를 벗어날 때 **한 번만** 전역에 반영한다.
+/// 호출 횟수는 실제 반복 횟수로 기록되므로 평균을 낼 수 있다.
+///
+/// ```ignore
+/// let mut acc = StageAccum::new(Stage::DistanceCalc);
+/// loop {
+///     acc.time(|| raw_scorer.score_points(&chunk, &mut buf));
+/// }
+/// // acc 가 범위를 벗어날 때 한 번 반영된다
+/// ```
+pub struct StageAccum {
+    #[cfg(feature = "stage-timing")]
+    stage: Stage,
+    #[cfg(feature = "stage-timing")]
+    nanos: u64,
+    #[cfg(feature = "stage-timing")]
+    count: u64,
+}
+
+impl StageAccum {
+    #[inline(always)]
+    pub fn new(stage: Stage) -> Self {
+        #[cfg(feature = "stage-timing")]
+        {
+            Self {
+                stage,
+                nanos: 0,
+                count: 0,
+            }
+        }
+        #[cfg(not(feature = "stage-timing"))]
+        {
+            let _ = stage;
+            Self {}
+        }
+    }
+
+    /// 클로저를 실행하고 걸린 시간을 지역 변수에 더한다.
+    #[inline(always)]
+    pub fn time<T>(&mut self, f: impl FnOnce() -> T) -> T {
+        #[cfg(feature = "stage-timing")]
+        {
+            let start = std::time::Instant::now();
+            let out = f();
+            self.nanos += start.elapsed().as_nanos() as u64;
+            self.count += 1;
+            out
+        }
+        #[cfg(not(feature = "stage-timing"))]
+        {
+            f()
+        }
+    }
+}
+
+impl Drop for StageAccum {
+    #[inline(always)]
+    fn drop(&mut self) {
+        #[cfg(feature = "stage-timing")]
+        {
+            if self.count > 0 {
+                let stat = &STATS[self.stage as usize];
+                stat.nanos.fetch_add(self.nanos, Ordering::Relaxed);
+                stat.count.fetch_add(self.count, Ordering::Relaxed);
+            }
+        }
+    }
+}
+
+/// 단계 하나의 관측값.
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct StageSnapshot {
+    pub stage: &'static str,
+    pub total_nanos: u64,
+    pub count: u64,
+    /// 호출 한 번당 평균 소요 시간. 호출이 없으면 0 이다.
+    pub mean_nanos: u64,
+}
+
+/// 현재까지 누적된 값을 읽는다. 계측이 꺼져 있으면 빈 목록을 돌려준다.
+pub fn snapshot() -> Vec<StageSnapshot> {
+    #[cfg(feature = "stage-timing")]
+    {
+        (0..STAGE_COUNT)
+            .map(|i| {
+                let total_nanos = STATS[i].nanos.load(Ordering::Relaxed);
+                let count = STATS[i].count.load(Ordering::Relaxed);
+                StageSnapshot {
+                    stage: STAGE_NAMES[i],
+                    total_nanos,
+                    count,
+                    mean_nanos: total_nanos.checked_div(count).unwrap_or(0),
+                }
+            })
+            .collect()
+    }
+    #[cfg(not(feature = "stage-timing"))]
+    {
+        Vec::new()
+    }
+}
+
+/// 누적값을 모두 0 으로 되돌린다. 측정 조건을 바꿀 때마다 호출한다.
+pub fn reset() {
+    #[cfg(feature = "stage-timing")]
+    {
+        for stat in STATS.iter() {
+            stat.nanos.store(0, Ordering::Relaxed);
+            stat.count.store(0, Ordering::Relaxed);
+        }
+    }
+}
+
+/// 계측이 켜진 빌드인지 알려 준다. 측정 결과에 함께 남겨 빌드를 구분한다.
+pub const fn is_enabled() -> bool {
+    cfg!(feature = "stage-timing")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn stage_names_match_enum_order() {
+        // 이름 배열과 열거값의 첨자가 어긋나면 지표가 조용히 뒤바뀐다.
+        assert_eq!(STAGE_NAMES.len(), STAGE_COUNT);
+        assert_eq!(Stage::SegmentReadLock as usize, 0);
+        assert_eq!(Stage::Rerun as usize, 8);
+        assert_eq!(Stage::QueueReserve as usize, 9);
+        assert_eq!(Stage::IndexUpdate as usize, STAGE_COUNT - 1);
+        assert_eq!(STAGE_NAMES[Stage::WalFlush as usize], "w2_wal_flush");
+        assert_eq!(
+            STAGE_NAMES[Stage::GlobalWriteLock as usize],
+            "w3_global_write_lock"
+        );
+    }
+
+    #[cfg(feature = "stage-timing")]
+    #[test]
+    fn accum_reports_each_iteration() {
+        reset();
+        {
+            let mut acc = StageAccum::new(Stage::DistanceCalc);
+            for _ in 0..5 {
+                acc.time(|| std::hint::black_box(1 + 1));
+            }
+        }
+        let snap = snapshot();
+        let s4 = &snap[Stage::DistanceCalc as usize];
+        assert_eq!(s4.count, 5, "루프 횟수가 그대로 기록되어야 한다");
+        reset();
